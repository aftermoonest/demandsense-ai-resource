---
// Rules hub (outer page): every rule, grouped by area in AREAS order. No rule detail pages yet.
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import IsoArt from '../../components/IsoArt.astro';
import TabBar from '../../components/TabBar.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import Sec from '../../components/Sec.astro';
import RuleRow from '../../components/RuleRow.astro';
import SubmitBand from '../../components/SubmitBand.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import { AREAS, T, type Area } from '../../site';

const rules = (await getCollection('rules')).sort((a, b) => a.data.number - b.data.number);
// Two-tone headline per area group
const HEAD: Record<Area, [string, string]> = {
  'reach-frequency': ['How often, and to how many.', 'Frequency means little without the share of the audience it reached'],
  'budget-reach': ['Where the money actually went.', 'Campaign totals hide which companies and roles the budget reached'],
  'building-account': ['Set up before you spend.', 'Structure, audiences and exclusions the reports depend on'],
  'signal-to-sales': ['From engagement to a sales call.', 'Which signals count, and how they reach a rep'],
  'ads-creative': ['When an ad stops working.', 'Telling real fatigue apart from the wrong audience'],
};
const groups = (Object.keys(AREAS) as Area[]).map((a) => ({ area: a, rules: rules.filter((r) => r.data.area === a) })).filter((g) => g.rules.length);
---
<Base type="rule" title={`${T.rules} · The B2B AI Standard for LinkedIn Ads`} description="What an experienced LinkedIn Ads advertiser checks before trusting a number, one rule at a time">

  <div class="top surface-black">
    <SiteHeader />
    <div class="wrap hero has-art">
      <IsoArt name="rules" dark place={[-231, -234, 1186, 975]} clip={856} accent="rule" class="hero-art" />
      <div class="copy">
        <Breadcrumbs items={[{ label: 'Directory', href: '/directory' }, { label: T.rules }]} />
        <h1 class="headline t-display">Check before you trust a number. <span class="tone-2">Each rule is one thing a seasoned advertiser looks at first, signed by the practitioner</span></h1>
      </div>
    </div>
  </div>
  <TabBar />

  <main id="main" class="ruled">
    <div class="wrap">
      {groups.map((g, i) => (
        <Sec id={`h-${g.area}`} label={AREAS[g.area]} title={HEAD[g.area][0]} context={HEAD[g.area][1]} class={i === 0 ? 'first' : undefined}>
          <ul class="rule-grid" data-reveal>
            {g.rules.map((r) => <li><RuleRow rule={r} /></li>)}
          </ul>
        </Sec>
      ))}
    </div>
  </main>

  <SubmitBand />
  <SiteFooter />
</Base>

<style>
  .top { position: relative; overflow: hidden; background: var(--bg); color: var(--text); }
  .top > :global(:not(.site-header)) { position: relative; }
  .hero { display: flex; justify-content: space-between; align-items: end; gap: 40px; padding-block: 40px; }
  .copy { display: grid; gap: 24px; }
  .copy .headline { max-width: 760px; min-height: 4lh; } /* room for four lines on every hub, so the tabs sit the same distance below */

  main :global(.first) { border-top: 0; }

  @media (max-width: 999px) { .hero { flex-direction: column; align-items: start; } }
  @media (max-width: 699px) { .hero { padding-block: 24px; gap: 24px; } }
</style>
