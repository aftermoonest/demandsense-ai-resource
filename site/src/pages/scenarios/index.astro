---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import IsoArt from '../../components/IsoArt.astro';
import TabBar from '../../components/TabBar.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import Sec from '../../components/Sec.astro';
import ScenarioCard from '../../components/ScenarioCard.astro';
import SubmitBand from '../../components/SubmitBand.astro';
import StepDot from '../../components/StepDot.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import { T } from '../../site';

const all = (await getCollection('scenarios')).sort((a, b) => a.data.order - b.data.order);
const ready = all.filter((s) => s.data.status === 'ready');
const soon = all.filter((s) => s.data.status === 'soon');
const steps = [
  { title: 'You run it', text: 'On fresh exports or your DemandSense account' },
  { title: 'The scenario does the prep', text: 'Its skills check the data against the Standard and your context' },
  { title: 'You act on it', text: 'A list or a report shows what to change in the campaigns' },
  { title: 'The results feed back', text: 'What you changed shows up in the data for the next run' },
];
---
<Base type="scenario" title={`${T.scenarios} · The B2B AI Standard for LinkedIn Ads`} description="Whole routines for LinkedIn Ads. Each one strings skills together to take on work you’d do by hand">

  <div class="top surface-black">
    <SiteHeader />
    <div class="wrap hero has-art">
      <IsoArt name="scenarios" dark place={[-181, -134, 1025, 848]} clip={761} accent="scenario" class="hero-art" />
      <div class="copy">
        <Breadcrumbs items={[{ label: 'Directory', href: '/directory' }, { label: T.scenarios }]} />
        <h1 class="headline t-display">Whole routines, ready to run. <span class="tone-2">Each one strings skills together to take on work you’d do by hand</span></h1>
      </div>
    </div>
  </div>
  <TabBar />

  <main id="main" class="ruled">
    <div class="wrap">
      <Sec id="h-ready" label="Ready to run" title="Choose a scenario and try it." context="They’re built around jobs you already do, from finding warm accounts to checking a new campaign" class="first">
        <ul class="list" data-reveal>
          {ready.map((s) => <li><ScenarioCard scenario={s} wide /></li>)}
        </ul>
      </Sec>

      <Sec id="h-how" label="How it works" title="Scenarios add to your LinkedIn routines." context="Take the manual work out, but keep the expertise and context in">
        <ol class="steps" data-reveal>
          <li class="loop" aria-hidden="true"><span class="chip out">↻ Loop</span></li>
          {steps.map((s, i) => (
            <li class:list={['step', { key: i === 0 }]}>
              <span class="tick"><StepDot n={i + 1} active={i === 0} /></span>
              <b class="t-h6">{s.title}</b>
              <p class="t-p2 body">{s.text}</p>
            </li>
          ))}
        </ol>
      </Sec>

      {soon.length > 0 && (
        <Sec id="h-soon" label="Coming next" title="Being written with their authors." context="Each one gets a page once it’s ready to run">
          <ul class="soon-grid" data-reveal>
            {soon.map((s) => <li><ScenarioCard scenario={s} compact /></li>)}
          </ul>
        </Sec>
      )}
    </div>
  </main>

  <SubmitBand />
  <SiteFooter />
</Base>

<style>
  .top { position: relative; overflow: hidden; background: var(--bg); color: var(--text); }
  .top > :global(:not(.site-header)) { position: relative; }
  .hero { display: flex; justify-content: space-between; align-items: end; gap: 40px; padding-block: 40px; }
  .copy { display: grid; gap: 24px; }
  .copy .headline { max-width: 760px; min-height: 4lh; } /* room for four lines on every hub, so the tabs sit the same distance below */

  main :global(.first) { border-top: 0; }
  .list { display: grid; gap: var(--gutter); }
  .soon-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--gutter); }

  /* Light take on the landing timeline: numbered stops on one line, the first one (start here) in orange; a dashed path under the row closes the loop */
  .steps { position: relative; display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); padding-bottom: 48px; }
  /* Dashed return path: out of step 4 to the right, down, back left under the text, up and into step 1 with an arrow */
  .loop { position: absolute; z-index: 1; top: 28px; bottom: 0; left: -32px; right: -32px; border: 1.5px dashed var(--neutral-300); border-top: 0; border-radius: 0 0 16px 16px; pointer-events: none; }
  .loop::before { content: ''; position: absolute; top: 0; left: 0; width: 38px; border-top: 1.5px dashed var(--neutral-300); transform: translateY(-50%); }
  .loop::after { content: ''; position: absolute; top: 0; left: 37px; border: 4.5px solid transparent; border-left: 6px solid var(--neutral-300); border-right: 0; transform: translateY(-50%); }
  .loop .chip { position: absolute; top: 100%; left: 50%; transform: translate(-50%, -50%); background: var(--bg); }
  .step { display: grid; gap: 8px; align-content: start; padding-right: 32px; }
  .step:last-child { padding-right: 0; }
  .tick { position: relative; z-index: 0; display: flex; align-items: center; height: 56px; margin-bottom: 8px; }
  .tick::after { content: ''; position: absolute; z-index: -1; left: 0; right: -32px; top: 50%; height: 1px; background: var(--line); }
  .step:last-child .tick::after { height: 0; background: none; border-top: 1.5px dashed var(--neutral-300); }
  .step .body { max-width: 36ch; }

  @media (max-width: 999px) {
    .soon-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .hero { flex-direction: column; align-items: start; }
    .steps { grid-template-columns: 1fr; gap: 24px; padding-bottom: 0; }
    .loop { display: none; }
    .step { grid-template-columns: 48px minmax(0, 1fr); column-gap: 16px; padding: 0; position: relative; }
    .step > * { grid-column: 2; }
    .step > .tick { grid-column: 1; grid-row: 1 / span 2; height: 48px; margin: 0; }
    .tick::after { display: none; }
    .step:not(:last-child)::before { content: ''; position: absolute; left: 23.5px; top: 48px; bottom: -24px; width: 1px; background: var(--line); }
  }
  @media (max-width: 699px) {
    .soon-grid { grid-template-columns: 1fr; }
    .hero { padding-block: 24px; gap: 24px; }
  }
</style>
