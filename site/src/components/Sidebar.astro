---
import { arrow } from '../arrows';
// Sibling nav for scenario, skill and rule pages, built as the DS Report sidebar (report-v2 .report-nav):
// 28px index tile + mono label; current = black tile with a white icon, dark label.
interface Item { label: string; href?: string; current?: boolean }
interface Props { label: string; items: Item[] }
const { label, items } = Astro.props;
const mark = arrow('right');
---
<nav class="side" aria-label={label}>
  <ol>
    {items.map((it, i) => {
      const Tag = it.href && !it.current ? 'a' : 'span';
      return (
        <li>
          <Tag class:list={['tab', { off: !it.href && !it.current }]} href={Tag === 'a' ? it.href : undefined} aria-current={it.current ? 'location' : undefined}>
            <span class="tile"><span class="n">{String(i + 1).padStart(2, '0')}</span><span class="ic" set:html={mark} /></span>
            <span class="t">{it.label}</span>
          </Tag>
        </li>
      );
    })}
  </ol>
</nav>

<style>
  .side { position: sticky; top: calc(var(--site-bar, 72px) + 40px); width: 220px; max-width: 100%; }
  ol { display: grid; gap: 4px; }
  .tab { display: flex; align-items: center; gap: 12px; min-height: 32px; padding: 2px; border-radius: var(--radius-4); font: 600 12px/1.4 var(--font-mono); text-transform: uppercase; color: var(--neutral-500); }
  .tile { position: relative; flex: none; width: 28px; height: 28px; border-radius: var(--radius-1); background: var(--neutral-0); transition: background-color 200ms var(--ease-out); }
  .n, .ic { position: absolute; inset: 0; display: grid; place-items: center; transition: opacity 200ms var(--ease-out); }
  .ic { opacity: 0; color: var(--neutral-0); }
  .ic :global(svg) { width: 16px; height: 16px; }
  .t { flex: 1; min-width: 0; transition: color 200ms var(--ease-out); }
  .tab[aria-current] { color: var(--neutral-950); }
  .tab[aria-current] .tile { background: var(--neutral-950); }
  .tab[aria-current] .n { opacity: 0; }
  .tab[aria-current] .ic { opacity: 1; }
  .off { color: var(--neutral-300); }
  @media (hover: hover) and (pointer: fine) { a.tab:hover { color: var(--neutral-950); } }
  @media (max-width: 999px) {
    .side { position: static; width: auto; overflow-x: auto; scrollbar-width: none; }
    ol { grid-auto-flow: column; justify-content: start; }
    .tab { white-space: nowrap; padding-right: 8px; }
  }
</style>
