---
// Rule row (Notion Marketplace list): large area icon, then category chip + rule number, the title with its one-line why, and labelled rows of skill and scenario chips.
import type { CollectionEntry } from 'astro:content';
import { getCollection } from 'astro:content';
import { AREAS, AREA_ICON, T } from '../site';
import { icon } from '../icons';
interface Props { rule: CollectionEntry<'rules'> }
const { id, data } = Astro.props.rule;
const skills = await getCollection('skills', (s) => s.data.rules.some((r) => r.id === id));
const scenarios = await getCollection('scenarios', (s) => s.data.rules.some((r) => r.id === id));
const MAX = 2; // chips per row before "+N"
const groups = [
  { label: T.skills, names: skills.map((s) => s.data.title) },
  { label: T.scenarios, names: scenarios.map((s) => s.data.title) },
].filter((g) => g.names.length);
---
<a data-type="rule" class="rrow" href={`/rules/${id}`}>
  <span class="ico" aria-hidden="true" set:html={icon(AREA_ICON[data.area])} />
  <span class="main">
    <span class="kick"><span class="chip">{AREAS[data.area]}</span><span class="lbl num">{T.rule} {String(data.number).padStart(2, '0')}</span></span>
    <span class="copy">
      <span class="t-h6 title">{data.title}</span>
      <span class="t-p2 body">{data.why}</span>
    </span>
    {groups.length > 0 && (
      <span class="tags">
        {groups.map((g) => (
          <>
            <span class="lbl">{g.label}:</span>
            <span class="chips">
              {g.names.slice(0, MAX).map((n) => <span class="chip out">{n}</span>)}
              {g.names.length > MAX && <span class="chip out more">+{g.names.length - MAX}</span>}
            </span>
          </>
        ))}
      </span>
    )}
  </span>
</a>

<style>
  .rrow { display: grid; grid-template-columns: 158px minmax(0, 1fr); gap: 24px; align-items: center; padding: 24px 16px; margin-inline: -16px; border-radius: var(--radius-4); transition: background-color var(--t-fast) var(--ease-out); }
  .ico { width: 158px; height: 158px; }
  .ico :global(.hl) { width: 100%; height: 100%; }
  .kick { display: flex; flex-wrap: wrap; align-items: center; gap: 16px; }
  .num { color: var(--text-2); }
  .main { display: grid; gap: 16px; }
  .copy { display: grid; gap: 4px; }
  .body { color: var(--text-body); }
  .tags { display: grid; grid-template-columns: max-content minmax(0, 1fr); align-items: center; gap: 16px 8px; }
  .chips { display: flex; flex-wrap: wrap; gap: 8px; }
  .chips .chip { white-space: normal; }
  .chips .more { color: var(--text-2); }
  @media (hover: hover) and (pointer: fine) {
    .rrow:hover { background: var(--bg-subtle); }
  }
  @media (max-width: 699px) {
    .rrow { grid-template-columns: 48px minmax(0, 1fr); gap: 16px; align-items: start; }
    .ico { width: 48px; height: 48px; }
    .tags { grid-template-columns: minmax(0, 1fr); gap: 8px; }
  }
</style>
