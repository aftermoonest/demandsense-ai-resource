---
import { arrow } from '../arrows';
import IsoArt from './IsoArt.astro';
// Closing CTA: a blue (primary 500) card on a black section, white button, the typewriter art beside the copy (DESIGN §15, §8.17).
import { CONTRIBUTE_URL } from '../site';
interface Props { title?: string; context?: string; lead?: string; button?: string; href?: string }
const {
  title = 'Run a check we don’t have?',
  context = 'Put it in the Standard',
  button = 'Bring your work',
  href = CONTRIBUTE_URL,
  lead = 'Send a skill or a whole scenario as you run it today. We package it, test it with you and publish it under your name, with your company and links on every page it appears on',
} = Astro.props;
// An "art" slot swaps in a page's own illustration for the catalogue
const own = Astro.slots.has('art');
---
<section class="close surface-black ruled" aria-labelledby="submit-h">
  <div class="wrap">
    <div class="card has-art">
      <div class="art">{own ? <slot name="art" /> : <IsoArt name="typewriter" blue />}</div>
      <div class="copy">
        <h2 id="submit-h" class="headline t-display">{title} <span class="tone-2">{context}</span></h2>
        <p class="t-p1 body lead">{lead}</p>
        <a class="btn filled lg" href={href}>{button}
          <Fragment set:html={arrow('right', 'go')} />
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  .close { background: var(--bg); padding-block: 104px 56px; } /* footer text follows close under the card */
  /* White text on the blue card; the button keeps the black section's white fill */
  .card { --pad: 64px; position: relative; isolation: isolate; overflow: hidden; border-radius: var(--radius-4); padding: 96px 64px; --bg: var(--primary-500); --text: var(--neutral-0); --text-2: rgb(255 255 255 / .7); --text-body: rgb(255 255 255 / .85); --line: rgb(255 255 255 / .2); background: var(--bg); color: var(--text); }
  .copy { position: relative; z-index: 1; display: grid; gap: var(--gap-body); justify-items: start; max-width: 650px; }
  .headline { max-width: 12em; }
  .lead { max-width: 480px; margin-bottom: 24px; } /* 40 to the button */
  /* Copy left, art in its own column right. The art column runs to the card's top, right and bottom edges and the
     figure fits inside it, so it sits the same at every width (no pixel placement) */
  .has-art { display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); gap: 32px; align-items: center; padding: 64px; }
  .has-art .copy { order: -1; }
  .has-art .headline { max-width: 20em; }
  .art { position: relative; align-self: stretch; margin: -64px -64px -64px 0; pointer-events: none; }
  /* Figma 1000:32834: the card keeps its copy-driven height; the machine is a fixed 617×544 (its drawn bounds), centred in the
     art column and bleeding 43px past the card's top and bottom edges at every desktop width. The svg is its viewBox ×1.488;
     the offsets move the drawing's own centre (not the viewBox's) onto the column's centre */
  @media (min-width: 1000px) { .card .art :global(.iso-art) { inset: auto; left: 50%; top: 50%; width: 685px; height: 589px; transform: translate(calc(-50% + 28px), calc(-50% - 7px)); } }
  .card .art > :global(*) { position: absolute; inset: 0; border-radius: 0; } /* .card: outranks IsoArt's own .iso-panel rule, which the production build loads later */
  .art :global(img) { object-fit: contain; }
  @media (max-width: 999px) { .close { padding-block: 80px 48px; } .card { --pad: 40px; padding: 64px 40px; } .art { order: -1; aspect-ratio: 1; margin: -64px -40px 0; } .has-art { grid-template-columns: minmax(0, 1fr); gap: 40px; } .has-art .copy { order: 0; } }
  @media (max-width: 699px) { .close { padding-block: 32px; } .card { padding: 32px 24px; } .art { margin: -32px -24px 0; } }
</style>
