---
// Copy button (every copy action on the site): primary blue, copy icon by default, tick once copied. The page wires the click; `copied()` from src/copy.ts flips the state.
const { class: cls, ...attrs } = Astro.props;
---
<button class:list={['btn brand xs copybtn', cls]} type="button" {...attrs}>
  <span class="ic" aria-hidden="true">
    <svg class="i-copy" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"><path d="M5.5 5.5h8v8h-8z" /><path d="M10.5 2.5h-8v8" /></svg>
    <svg class="i-done" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M3 8.5l3.2 3L13 4.5" /></svg>
  </span>
  <span class="lb">Copy</span>
</button>

<style>
  .copybtn { gap: 8px; }
  .ic { display: grid; width: 16px; height: 16px; }
  .ic svg { grid-area: 1 / 1; width: 100%; height: 100%; transition: opacity var(--t-fast) var(--ease-out), transform var(--t-fast) var(--ease-out); }
  .i-done, .copybtn[data-copied] .i-copy { opacity: 0; transform: scale(.6); }
  .copybtn[data-copied] .i-done { opacity: 1; transform: none; }
  @media (prefers-reduced-motion: reduce) { .ic svg { transition: none; } }
</style>
