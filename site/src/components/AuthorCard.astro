---
// Author card: photo, name, role and company, a 2-line bio, count of their work. Initials stand in until photos arrive.
import type { CollectionEntry } from 'astro:content';
import { getCollection } from 'astro:content';
import { T } from '../site';
interface Props { author: CollectionEntry<'authors'> }
const { id, data } = Astro.props.author;
const mine = (e: { data: { author?: { id: string } } }) => e.data.author?.id === id;
const nSc = (await getCollection('scenarios', mine)).length;
const nSk = (await getCollection('skills', mine)).length;
const count = [
  nSc && `${nSc} ${(nSc === 1 ? T.scenario : T.scenarios).toLowerCase()}`,
  nSk && `${nSk} ${(nSk === 1 ? T.skill : T.skills).toLowerCase()}`,
].filter(Boolean).join(' · ');
const initials = data.name.split(' ').map((w) => w[0]).slice(0, 2).join('');
const job = [data.role, data.company].filter(Boolean).join(', ');
---
<a class="acard" href={`/authors/${id}`}>
  <span class="photo">
    {data.photo
      ? <img src={data.photo} alt="" loading="lazy" />
      : <><span class="pattern dots" aria-hidden="true" /><span class="ini t-n2" aria-hidden="true">{initials}</span></>}
  </span>
  <span class="txt">
    <span class="t-h6">{data.name}</span>
    {job && <span class="t-p2 job">{job}</span>}
    {data.about && <span class="t-p2 body about">{data.about}</span>}
  </span>
  {count && <span class="lbl-2 count">{count}</span>}
</a>

<style>
  /* Grid card: no frame of its own; the rail draws the cell lines */
  .acard { display: grid; grid-template-rows: auto 1fr auto; height: 100%; padding-block: 16px 24px; overflow: hidden; transition: background-color var(--t-fast) var(--ease-out); }
  /* Round portrait, 140px, top-left of the card */
  .photo { position: relative; display: grid; place-items: center; width: 140px; height: 140px; margin: 24px 24px 0; border-radius: 50%; background: var(--bg-subtle); box-shadow: inset 0 0 0 1px var(--line-card); overflow: hidden; }
  .photo img { width: 100%; height: 100%; object-fit: cover; }
  .dots { position: absolute; inset: 0; --dot: var(--neutral-100); }
  :global(.surface-black) .dots { --dot: var(--neutral-850); }
  .ini { position: relative; color: var(--text-meta); transition: color var(--t-fast) var(--ease-out); }
  .txt { display: grid; grid-template-columns: minmax(0, 1fr); gap: 4px; align-content: start; padding: 24px 24px 0; }
  .job { color: var(--text-2); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; } /* one line; the full role shows on the profile */
  .about { display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; margin-top: 12px; }
  .count { margin: 24px 24px 0; } /* the card's own bottom padding holds cards without a count too */
  @media (hover: hover) and (pointer: fine) {
    .acard:hover { background: var(--bg-subtle); }
    .acard:hover .ini { color: var(--text); }
  }
</style>
