---
// Detail-page CTA: a card on the item's hero colour (its pastel cover) at the end of the content column.
// Two-tone headline with the black button under it on the left; the page's hero illustration on the right (slot "art").
// Only scenario, skill and rule pages carry one; the footer SubmitBand stays the same on every page.
import { arrow } from '../../arrows';
import { CONTRIBUTE_URL } from '../../site';
interface Props { title: string; context?: string; button?: string; href?: string; cover?: number }
const { title, context = 'Put it in the Standard', button = 'Bring your work', href = CONTRIBUTE_URL, cover } = Astro.props;
const art = Astro.slots.has('art');
---
<aside class:list={['cta', { 'has-art': art }]} data-reveal style={cover ? `--cover: var(--pastel-${cover}); --cover-200: var(--pastel-${cover}-200); --cover-450: var(--pastel-${cover}-450)` : undefined}>
  <div class="copy">
    <p class="t-h4 headline">{title} {context && <span class="tone-2">{context}</span>}</p>
    <a class="btn filled" href={href}>{button} <Fragment set:html={arrow('right', 'go')} /></a>
  </div>
  {art && <div class="art" aria-hidden="true"><slot name="art" /></div>}
</aside>

<style>
  .cta { position: relative; display: grid; grid-template-columns: minmax(0, 1fr); align-items: center; gap: 32px; padding: 64px; overflow: hidden; background: var(--cover, var(--bg-subtle)); }
  .has-art { grid-template-columns: minmax(0, 7fr) minmax(0, 5fr); }
  .copy { display: grid; justify-items: start; gap: 40px; }
  .headline { text-wrap: balance; }
  .headline .tone-2 { display: block; } /* claim and context on two lines */
  /* Art bleeds to the card's top, right and bottom edges, as in the hero, with the hero's accents */
  .art { position: relative; align-self: stretch; margin: -64px -64px -64px 0; } /* card height comes from the copy: 64px on every side */
  /* Same fit as the hero's art box (DetailHero .hart, skill .kart), so the figure reads identical */
  .art > :global(svg), .art > :global(img) { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: contain; }
  .art > :global(.kart) { position: absolute; inset: 12%; display: block; }
  .art :global(.hl) { --hairline-hi: var(--cover-450); width: 100%; height: 100%; }
  /* Full width of the content column: edge line to edge line (1px short so the lines stay), and down to the frame's bottom when last */
  .cta { margin-inline: calc(1px - var(--pad, 0px)); }
  .cta:last-child { margin-bottom: calc(-1 * var(--section-ruled-bottom)); }
  @media (max-width: 999px) { .cta { padding: 40px; } .has-art { grid-template-columns: minmax(0, 1fr); } .art { order: -1; aspect-ratio: 4 / 3; min-height: 0; margin: -40px -40px 0; } }
  @media (max-width: 699px) { .cta { padding: 32px 24px; } .art { margin: -32px -24px 0; } }
</style>
